// Inspired by Catnap
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
       "source": "/home/ecoy/Pictures/Icons/IMG_1350.jpeg",
        "position": "left",
         "width": 27,
        "padding": {
            "top": 1,
            "bottom": 10,
            "left": 0,
            "right": 1,
        },
    },

    "display": {
        "size": {
            "binaryPrefix":"jedec"
        },
        "separator": " "
    },
    "display": {
        "separator": " 󰑃  ",
    },
    "modules": [
        "break",
        {
            "type": "os",
            "key": " DISTRO    󰁔 ",
            "format": "{3}",
            "keyColor": "#babbf1",
        },
        {
            "type": "kernel",
            "key": "│ ├ kernel 󰁔 ",
            "keyColor": "#babbf1",
        },
        {
            "type": "packages",
            "key": "│ ├󰏖 pkgs   󰁔 ",
            "keyColor": "#babbf1",
        },
        {
            "type": "shell",
            "key": "│ ├ shell  󰁔 ",
            "keyColor": "#babbf1",
        },
        {
            "type": "wm",
            "key": "│ ├ DE/WM  󰁔 ",
            "keyColor": "#babbf1",
        },
        {
            "type": "terminal",
            "key": "│ └ term   󰁔 ",
            "keyColor": "#babbf1",
        },
        {
            "type": "title",
            "key": "󰌢 SYSTEM    󰁔 ",
            "keyColor": "#babbf1",
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠 cpu    󰁔 ",
            "keyColor": "#babbf1",
        },
        {
            "type": "gpu",
            "key": "│ ├󰻑 gpu    󰁔 ",
            "keyColor": "#babbf1",
        },
        {
            "type": "disk",
            "key": "│ ├󰋊 disk   󰁔 ",
            "keyColor": "#babbf1",
        },
        {
            "type": "memory",
            "key": "│ ├󰾆 memory 󰁔 ",
            "keyColor": "#babbf1",
        },
        {
            "type": "uptime",
            "key": "│ ├󰅐 uptime 󰁔 ",
            "keyColor": "#babbf1",
        },
        {
            "type": "battery",
            "key": "│ ├󰅐 power  󰁔 ",
            "keyColor": "#babbf1",
        },
        {
            "type": "command",
            "key": "│ └󰅐 OS Age 󰁔 ",
            "keyColor": "#babbf1",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "sound",
            "key": " AUDIO     󰁔 ",
            "keyColor": "#babbf1"
        },
        {
            "type": "player",
            "key": " ├󰥠 player  󰁔 ",
            "keyColor": "#babbf1",
        },
        {
            "type": "media",
            "key": " └󰝚 media   󰁔 ",
            "format": "{2} - {3}",
            "keyColor": "#babbf1",
        },
    
        "break",
    ],
}
